---
import BaseLayout from '@/layouts/BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  price: string;
  includes: string[];
  eyebrow?: string;
  heroImage?: string;
  relatedServices?: { title: string; href: string }[];
}

const {
  price,
  includes,
  eyebrow,
  heroImage,
  relatedServices,
  ...baseProps
} = Astro.props;
---

<BaseLayout {...baseProps}>
  <section class="py-20">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        {eyebrow && (
          <p class="text-brand font-semibold text-sm tracking-wide uppercase mb-4">
            {eyebrow}
          </p>
        )}
        <h1 class="text-4xl md:text-5xl font-extrabold text-text mb-6">
          {baseProps.title}
        </h1>
        <p class="text-lg text-muted mb-8 max-w-2xl mx-auto">
          {baseProps.description}
        </p>
        <p class="text-3xl font-bold text-brand mb-4">{price}</p>

        {heroImage && (
          <img
            src={heroImage}
            alt={baseProps.title}
            class="rounded-xl shadow-lg mx-auto mb-12"
            width="800"
            height="450"
          />
        )}

        {includes.length > 0 && (
          <div class="mt-12">
            <h2 class="text-2xl font-bold text-text mb-6">¿Qué incluye?</h2>
            <ul class="inline-flex flex-wrap gap-3 justify-center">
              {includes.map((item) => (
                <li class="bg-bg-alt text-text px-4 py-2 rounded-full text-sm font-medium border border-stroke">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <div class="mt-16">
        <slot />
      </div>

      {relatedServices && relatedServices.length > 0 && (
        <div class="mt-20 border-t border-stroke pt-12">
          <h2 class="text-2xl font-bold text-text text-center mb-8">
            Servicios relacionados
          </h2>
          <div class="flex flex-wrap gap-4 justify-center">
            {relatedServices.map((svc) => (
              <a
                href={svc.href}
                class="text-brand font-semibold hover:underline"
              >
                {svc.title}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
