---
import ScrollReveal from '@/components/animations/ScrollReveal.astro';
import Particles from '@/components/animations/Particles.astro';
import StatsCounter from '@/components/animations/StatsCounter.astro';
---

<section class="hero relative overflow-hidden" aria-labelledby="h1-hero">
  <Particles />

  <div class="container relative z-10" style="padding-top: 100px; padding-bottom: 80px;">
    <ScrollReveal>
      <p class="eyebrow">Desarrollo Web + Inteligencia Artificial</p>
    </ScrollReveal>

    <ScrollReveal delay={150}>
      <h1 id="h1-hero" class="hero-title">Tu presencia online profesional desde $280</h1>
    </ScrollReveal>

    <ScrollReveal delay={300}>
      <p class="hero-lead">
        Somos un <strong>equipo de desarrollo web especializado</strong> con capacidades tecnológicas integrales.
        Ofrecemos soluciones probadas: <strong>One Page desde $280</strong> para presencia online básica y
        <strong>Ecommerce completo por $450</strong> para vender online. Todos nuestros proyectos incluyen
        <strong>SEO</strong>, <strong>hosting</strong> y <strong>automatización con IA</strong>.
      </p>
    </ScrollReveal>

    <ScrollReveal delay={450}>
      <div class="hero-cta">
        <a class="btn-cta" href="/#servicios"><span>Ver servicios</span></a>
      </div>
    </ScrollReveal>

    <ScrollReveal delay={600}>
      <ul class="stats" aria-label="Indicadores de confianza">
        <StatsCounter target={50} prefix="más de" label="Páginas Web Creadas" />
        <StatsCounter target={25} prefix="más de" label="Clientes Satisfechos" />
        <StatsCounter target={3} label="Años de Experiencia" />
        <StatsCounter target={98} suffix="%" label="de Satisfacción" />
      </ul>
    </ScrollReveal>
  </div>
</section>

<style>
  .hero {
    padding: 24px 0 24px;
    min-height: calc(100vh - var(--header-h));
    display: flex;
    align-items: center;
    position: relative;
    background: linear-gradient(180deg, #fff, #f9fbff);
  }

  .eyebrow {
    color: var(--color-brand);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 12px;
    text-align: center;
  }

  .hero-title {
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.1;
    margin: 10px 0;
    font-weight: 800;
    background: linear-gradient(90deg, #0b1220, var(--color-brand));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
  }

  .hero-lead {
    color: var(--color-muted);
    font-size: 18px;
    margin-bottom: 18px;
    max-width: 70ch;
    margin-inline: auto;
    text-align: center;
    line-height: 1.7;
  }

  .hero-lead strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .hero-cta {
    display: flex;
    gap: 12px;
    margin: 14px 0 6px;
    justify-content: center;
    margin-bottom: 48px;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    border-radius: 12px;
    border: 2px solid var(--color-cta);
    background: linear-gradient(135deg, var(--color-cta), var(--color-cta-2));
    color: #fff;
    font-weight: 700;
    font-size: 18px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 6px 20px rgba(255, 107, 53, 0.3);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  .btn-cta:hover {
    background: linear-gradient(135deg, var(--color-cta-2), var(--color-cta));
    border-color: var(--color-cta-2);
    box-shadow: 0 10px 32px rgba(255, 107, 53, 0.4);
    transform: translateY(-3px) scale(1.02);
    text-decoration: none;
  }

  .btn-cta:active {
    transform: translateY(-1px) scale(1.01);
  }

  .stats {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    justify-content: center;
  }

  .stats li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    min-width: 120px;
  }

  .stats__prefix {
    font-size: 12px;
    color: var(--color-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .stats__num {
    font-weight: 800;
    font-size: 2.5rem;
    color: var(--color-brand);
    line-height: 1;
    margin: 0;
  }

  .stats__label {
    color: var(--color-muted);
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    line-height: 1.3;
    max-width: 100px;
  }

  @media (max-width: 768px) {
    .hero { min-height: auto; padding: 40px 0; }
    .hero-title { font-size: 2rem; }
    .btn-cta { padding: 14px 24px; font-size: 16px; }
  }
</style>
