---
import ScrollReveal from '@/components/animations/ScrollReveal.astro';

const steps = [
  {
    num: 1,
    emoji: '📋',
    title: 'Brief y Auditoría',
    desc: 'Auditoría técnica, benchmark de competidores y análisis de intención de búsqueda.',
    details: [
      'Análisis de tu negocio actual',
      'Estudio de la competencia',
      'Auditoría técnica del sitio',
    ],
  },
  {
    num: 2,
    emoji: '🔍',
    title: 'Investigación',
    desc: 'Keywords, propuesta de valor y arquitectura de información orientada a conversión.',
    details: [
      'Investigación de palabras clave',
      'Definición de propuesta de valor',
      'Arquitectura de información',
    ],
  },
  {
    num: 3,
    emoji: '📊',
    title: 'Propuesta',
    desc: 'Roadmap con quick wins y backlog. Estimación de tráfico/leads esperados.',
    details: [
      'Roadmap de implementación',
      'Quick wins identificados',
      'Estimación de resultados',
    ],
  },
  {
    num: 4,
    emoji: '⚡',
    title: 'Implementación',
    desc: 'Desarrollo, SEO On‑Page, rendimiento y analítica (GA4, eventos, conversiones).',
    details: [
      'Desarrollo del sitio web',
      'Optimización SEO On-Page',
      'Configuración de analítica',
    ],
  },
  {
    num: 5,
    emoji: '📈',
    title: 'Medición y Optimización',
    desc: 'Seguimiento de KPIs: leads, tasa de conversión, CWV, visibilidad y CAC. Iteración continua.',
    details: [
      'Seguimiento de KPIs',
      'Optimización continua',
      'Reportes mensuales',
    ],
  },
]
---

<section id="estrategia" class="section section--alt" aria-labelledby="process-heading">
  <div class="container">
    <ScrollReveal>
      <h2 id="process-heading" class="text-reveal text-center">Proceso para iniciar un proyecto</h2>
    </ScrollReveal>

    <ScrollReveal delay={100}>
      <p class="section-lead text-center">
        Trabajo con un flujo basado en datos para que tu inversión genere resultados medibles.
      </p>
    </ScrollReveal>

    <div class="process-timeline">
      {steps.map((step, i) => (
        <ScrollReveal delay={i * 120}>
          <div class="process-step">
            <div class="process-step-icon">
              <span class="step-number">{step.num}</span>
              <div class="step-emoji">{step.emoji}</div>
            </div>
            <div class="process-step-content">
              <h3 class="process-step-title">{step.title}</h3>
              <p class="process-step-desc">{step.desc}</p>
              <ul class="process-step-details">
                {step.details.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          </div>
        </ScrollReveal>
      ))}
    </div>

    <ScrollReveal delay={400}>
      <div class="process-cta text-center">
        <h3>¿Listo para empezar tu proyecto?</h3>
        <p>Cada paso está diseñado para maximizar el ROI de tu inversión en marketing digital.</p>
        <div class="process-cta-buttons">
          <a
            class="btn-primary"
            href="https://wa.me/584242536795?text=Hola%20Alfredo%2C%20quiero%20iniciar%20mi%20proyecto"
            target="_blank"
            rel="nofollow noopener"
          >
            Iniciar mi proyecto
          </a>
          <a class="btn-ghost" href="/#contacto">Tengo preguntas</a>
        </div>
      </div>
    </ScrollReveal>
  </div>
</section>

<style>
  .text-center {
    text-align: center;
  }

  .text-reveal {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 800;
    color: var(--color-text);
    margin: 0 0 8px;
    line-height: 1.25;
  }

  .section-lead {
    font-size: 1.05rem;
    color: var(--color-muted);
    max-width: 650px;
    margin-inline: auto;
    margin-bottom: 40px;
    line-height: 1.7;
  }

  .process-timeline {
    position: relative;
    max-width: 720px;
    margin-inline: auto;
    padding-left: 0;
  }

  .process-timeline::before {
    content: '';
    position: absolute;
    left: 28px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(180deg, var(--color-brand), var(--color-brand-2), var(--color-brand));
  }

  .process-step {
    display: flex;
    gap: 24px;
    margin-bottom: 32px;
    position: relative;
  }

  .process-step:last-child {
    margin-bottom: 0;
  }

  .process-step-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 56px;
    position: relative;
    z-index: 1;
  }

  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-brand), var(--color-brand-2));
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 4px;
    box-shadow: 0 2px 12px rgba(43, 132, 255, 0.3);
  }

  .step-emoji {
    font-size: 1.1rem;
  }

  .process-step-content {
    flex: 1;
    background: var(--color-card);
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    padding: 20px 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .process-step-content:hover {
    transform: translateX(4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .process-step-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 4px;
  }

  .process-step-desc {
    font-size: 0.9rem;
    color: var(--color-muted);
    margin: 0 0 12px;
    line-height: 1.6;
  }

  .process-step-details {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .process-step-details li {
    font-size: 0.8rem;
    color: var(--color-brand);
    background: rgba(43, 132, 255, 0.07);
    padding: 4px 10px;
    border-radius: 6px;
    font-weight: 500;
  }

  .process-cta {
    margin-top: 48px;
    padding: 40px;
    background: linear-gradient(135deg, rgba(43, 132, 255, 0.05), rgba(105, 167, 255, 0.08));
    border-radius: 20px;
    border: 1px solid rgba(43, 132, 255, 0.1);
  }

  .process-cta h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 8px;
  }

  .process-cta p {
    font-size: 0.95rem;
    color: var(--color-muted);
    margin: 0 0 24px;
  }

  .process-cta-buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    border-radius: 12px;
    border: 2px solid #ff6b35;
    background: linear-gradient(135deg, #ff6b35, #f7931e);
    color: #fff;
    font-weight: 700;
    font-size: 18px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 6px 20px rgba(255, 107, 53, 0.3);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #f7931e, #ff6b35);
    border-color: #f7931e;
    box-shadow: 0 10px 32px rgba(255, 107, 53, 0.4);
    transform: translateY(-3px) scale(1.02);
    text-decoration: none;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;
    border-radius: 12px;
    border: 2px solid var(--color-stroke);
    background: transparent;
    color: var(--color-text);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .btn-ghost:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .process-timeline::before {
      left: 16px;
    }

    .process-step-icon {
      width: 36px;
    }

    .step-number {
      width: 26px;
      height: 26px;
      font-size: 0.75rem;
    }

    .process-step {
      gap: 16px;
    }

    .process-step-content {
      padding: 16px;
    }
  }
</style>
