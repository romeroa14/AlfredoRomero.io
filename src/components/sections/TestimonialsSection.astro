---
import ScrollReveal from '@/components/animations/ScrollReveal.astro';

const testimonials = [
  {
    quote: 'El sitio cargó más rápido y subimos posiciones en Google en pocas semanas.',
    author: 'María P.',
    role: 'Retail en Caracas',
  },
  {
    quote: 'La tienda online duplicó las ventas. El panel nos ahorra horas cada semana.',
    author: 'José L.',
    role: 'Ecommerce',
  },
  {
    quote: 'El asistente con IA resolvió consultas frecuentes y liberó al equipo de soporte.',
    author: 'Andrea R.',
    role: 'Servicios',
  },
]
---

<section id="testimonios" class="section section--alt" aria-labelledby="testimonials-heading">
  <div class="container">
    <ScrollReveal>
      <h2 id="testimonials-heading" class="text-reveal text-center">Lo que dicen mis clientes</h2>
    </ScrollReveal>

    <div class="testimonials-grid">
      {testimonials.map((t, i) => (
        <ScrollReveal delay={i * 150}>
          <figure class="testimonial-card">
            <blockquote class="testimonial-quote">{t.quote}</blockquote>
            <figcaption class="testimonial-author">
              <strong>{t.author}</strong>
              <span>{t.role}</span>
            </figcaption>
          </figure>
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>

<style>
  .text-center {
    text-align: center;
  }

  .text-reveal {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 800;
    color: var(--color-text);
    margin: 0 0 32px;
    line-height: 1.25;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .testimonial-card {
    background: var(--color-card);
    border: 1px solid var(--color-stroke);
    border-radius: 16px;
    padding: 28px;
    margin: 0;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .testimonial-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .testimonial-quote {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0 0 16px;
    font-style: italic;
    position: relative;
    padding-top: 8px;
  }

  .testimonial-quote::before {
    content: '"';
    font-size: 3rem;
    color: var(--color-brand);
    opacity: 0.25;
    position: absolute;
    top: -12px;
    left: -4px;
    line-height: 1;
  }

  .testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px solid var(--color-stroke);
    padding-top: 14px;
  }

  .testimonial-author strong {
    font-size: 0.92rem;
    color: var(--color-text);
    font-weight: 600;
  }

  .testimonial-author span {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
