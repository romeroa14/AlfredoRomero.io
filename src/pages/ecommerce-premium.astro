        <div class="price-breakdown">
          <div class="price-item"><span class="service-name">Ecommerce Completo</span><span class="service-price">$450</span></div>
          <div class="price-item"><span class="service-name">SEO Ecommerce</span><span class="service-price">$150</span></div>
          <div class="price-item"><span class="service-name">Diseño Figma</span><span class="service-price">$140</span></div>
          <div class="price-divider"></div>
          <div class="price-total"><span class="total-label">TOTAL</span><span class="total-price">$1,100</span></div>
