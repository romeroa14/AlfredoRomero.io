---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Particles from '@/components/animations/Particles.astro';
---

<BaseLayout
  title="Ecommerce Premium Completo $1,100 | Alfredo Romero - Crecimiento Digital 360°"
  description="Transforma tu negocio con nuestro Ecommerce Premium Completo por $1,100. Incluye tienda online, SEO, diseño Figma, Google Analytics, Facebook Ads y más."
  keywords="ecommerce premium venezuela, tienda online completa, desarrollo web caracas, SEO ecommerce, diseño figma, google analytics, facebook ads, crecimiento digital"
  canonical="/ecommerce-premium"
>
  <!-- HERO -->
  <section class="hero-premium">
    <Particles />
    <div class="container" style="position:relative;z-index:1;padding:60px 0 40px">
      <div class="hero-badge">
        <span class="badge-text">🔥 OFERTA POR TIEMPO LIMITADO</span>
      </div>

      <h1 class="hero-title-premium">
        <span class="highlight">TRANSFORMA TU NEGOCIO</span><br>
        Con El Ecommerce Más Completo<br>
        <span class="price-highlight">Por Solo $1,100</span>
      </h1>

      <p class="hero-lead-premium">
        <strong>La solución digital 360° que tu negocio necesita para dominar internet.</strong><br>
        No solo una tienda online, sino un <strong>ecosistema digital completo</strong> que incluye SEO,
        diseño profesional, Google Analytics, Facebook Ads y más. Todo lo que necesitas para
        <strong>multiplicar tus ventas online</strong> en un solo paquete.
      </p>

      <div class="hero-stats-premium">
        <div class="stat-item"><span class="stat-number">$1,100</span><span class="stat-label">Inversión Total</span></div>
